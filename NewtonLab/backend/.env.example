# Variables del proceso prevalecen sobre backend/.env. Nunca versionar .env.
# Estos valores ilustrativos deben coincidir con el .env de Compose en la raíz.
DATABASE_URL=
TEST_DATABASE_URL=
NEWTONLAB_CALCULATION_TIMEOUT=10
# Lista separada por comas de orígenes exactos, sin rutas ni comodines.
CORS_ORIGINS=
# En producción: DATABASE_URL del proveedor; agregá sslmode según su política TLS.
# No configurar TEST_DATABASE_URL en Heroku.
